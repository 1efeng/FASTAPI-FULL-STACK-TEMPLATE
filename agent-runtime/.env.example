# Aegra runtime environment — copy to .env and fill secrets locally.

# --- Application ---
PROJECT_NAME=travel-agent-runtime
VERSION=0.1.0
DEBUG=true
AEGRA_CONFIG=aegra.json
# For multi-instance deployment set false and run `aegra db upgrade` once
# before starting the instances.
RUN_MIGRATIONS_ON_STARTUP=true

# --- PostgreSQL ---
# Prefer one connection string in containers/cloud. Aegra also accepts the
# individual POSTGRES_* fields below when DATABASE_URL is unset.
# DATABASE_URL=postgresql://postgres:changethis@localhost:5432/app
POSTGRES_HOST=localhost
# Host port used by agent-runtime/docker-compose.yml.
POSTGRES_HOST_PORT=15433
POSTGRES_PORT=15433
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis
DB_ECHO_LOG=false
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_MAX_OVERFLOW=20
LANGGRAPH_MIN_POOL_SIZE=5
LANGGRAPH_MAX_POOL_SIZE=20

# --- Authentication ---
# aegra.json registers the custom JWT bridge. SECRET_KEY must equal the
# FastAPI SECRET_KEY because FastAPI issues the bearer token.
AUTH_TYPE=custom
SECRET_KEY=changethis

# --- Server / logging ---
HOST=0.0.0.0
PORT=2026
LOG_LEVEL=INFO
ENV_MODE=LOCAL
LOG_VERBOSITY=standard

# --- Redis broker and workers ---
# Keep disabled for single-process `aegra dev`; enable it for multi-instance
# execution, cross-instance SSE replay, cancellation and crash recovery.
REDIS_BROKER_ENABLED=false
REDIS_URL=redis://localhost:16380/0
REDIS_HOST_PORT=16380
WORKER_COUNT=3
N_JOBS_PER_WORKER=10
WORKER_DRAIN_TIMEOUT=30
BG_JOB_TIMEOUT_SECS=3600
BG_JOB_MAX_RETRIES=3
STUCK_PENDING_THRESHOLD_SECONDS=120
LEASE_DURATION_SECONDS=30
HEARTBEAT_INTERVAL_SECONDS=10
REAPER_INTERVAL_SECONDS=15

# --- Agent Protocol v2 ---
FF_V2_EVENT_STREAMING=true

# --- LangChain ChatModel (OpenAI-compatible) ---
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_BASE_URL=
# Backward-compatible local alias; prefer LLM_API_KEY.
DOUBAO_PLAN_API_KEY=

# This project does not currently use Aegra cron scheduling or telemetry.
CRON_ENABLED=false
ENABLE_PROMETHEUS_METRICS=false
OTEL_TARGETS=
