# Aegra runtime env — copy to .env (repo root already has most values).
# Model (graph reads these; falls back to OPENAI_*)
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=
DOUBAO_PLAN_API_KEY=

# Aegra core
PORT=2026
HOST=0.0.0.0
AUTH_TYPE=noop            # aegra.json auth.path takes precedence when set
REDIS_BROKER_ENABLED=true
REDIS_URL=redis://localhost:6379/0

# PostgreSQL (Aegra uses DATABASE_URL or POSTGRES_*)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Worker / drain
WORKER_COUNT=3
N_JOBS_PER_WORKER=10
WORKER_DRAIN_TIMEOUT=30
