# Domain
# This would be set to the production domain with an env var on deployment
# used by Traefik to transmit traffic and acquire TLS certificates
DOMAIN=localhost
# To test the local Traefik config
# DOMAIN=localhost.tiangolo.com

# Public host for the Aegra Agent Protocol/SSE service in production.
AGENT_DOMAIN=agent.localhost

# Public frontend URL, used by the backend to generate links in emails.
# Use the FastAPI application URL for local Docker Compose; deployments use the deployed application URL.
FRONTEND_HOST=http://localhost:8000
# In staging and production, set this env var to the frontend host, e.g.
# FRONTEND_HOST=https://example.com

# Public Aegra URL injected into the production frontend bundle.
# Use a separate HTTPS host so SSE and Agent Protocol traffic do not go through FastAPI.
VITE_AEGRA_URL=https://agent.localhost

# Environment: local, staging, production
ENVIRONMENT=local

PROJECT_NAME="Full Stack FastAPI Project"
STACK_NAME=full-stack-fastapi-project

# Backend
BACKEND_CORS_ORIGINS="http://localhost,https://localhost,http://localhost.tiangolo.com"
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# LangChain ChatModel (OpenAI-compatible)
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_BASE_URL=

# Emails
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# FastAPI processes per backend container in compose.production.yml
FASTAPI_WORKERS=2

SENTRY_DSN=

# Configure these with your own Docker registry images
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_AEGRA=travel-agent-runtime

# Aegra production defaults (used by compose.production.yml)
AEGRA_WORKER_COUNT=2
AEGRA_N_JOBS_PER_WORKER=4
AEGRA_SQLALCHEMY_POOL_SIZE=5
AEGRA_SQLALCHEMY_MAX_OVERFLOW=5
AEGRA_LANGGRAPH_MIN_POOL_SIZE=2
AEGRA_LANGGRAPH_MAX_POOL_SIZE=5
WORKER_DRAIN_TIMEOUT=30
