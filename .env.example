# Domain
# This would be set to the production domain with an env var on deployment
# used by Traefik to transmit traffic and acquire TLS certificates
DOMAIN=localhost
# To test the local Traefik config
# DOMAIN=localhost.tiangolo.com

# Public frontend URL, used by the backend to generate links in emails.
# Use the FastAPI application URL for local Docker Compose; deployments use the deployed application URL.
FRONTEND_HOST=http://localhost:8000
# In staging and production, set this env var to the frontend host, e.g.
# FRONTEND_HOST=https://example.com

# Environment: local, staging, production
ENVIRONMENT=local

PROJECT_NAME="Full Stack FastAPI Project"
STACK_NAME=full-stack-fastapi-project

# Backend
BACKEND_CORS_ORIGINS="http://localhost,https://localhost,http://localhost.tiangolo.com"
# Uvicorn 仅信任本机代理；Docker Compose 会在私有网络内覆盖为信任 Traefik。
FORWARDED_ALLOW_IPS=127.0.0.1
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

SENTRY_DSN=

# Configure these with your own Docker registry images
DOCKER_IMAGE_BACKEND=backend

# Shared runtime / AI infrastructure
# Redis 连接，用于缓存和共享状态。
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=travel_agent:
# 单个来源 IP 每分钟允许发起的 Chat 请求数。
CHAT_IP_RATE_LIMIT_PER_MINUTE=60
# 单个用户每分钟允许发起的 Chat 请求数。
CHAT_USER_RATE_LIMIT_PER_MINUTE=20
# 单个用户每日允许执行的 Chat 请求数。
CHAT_DAILY_QUOTA=100
# 单个用户允许同时运行的 Chat 请求数。
CHAT_CONCURRENT_LIMIT=2
# Redis 故障时的保护策略：fail_closed 阻止昂贵请求，fail_open 允许降级放行。
CHAT_REDIS_FAILURE_POLICY=fail_closed
# LiteLLM Proxy 地址。
LITELLM_BASE_URL=http://litellm:4000
# FastAPI 调用 LiteLLM 的服务凭证。
LITELLM_SERVICE_KEY=sk-local-travel
# 应用使用的逻辑模型名。
LLM_LOGICAL_MODEL=travel-agent-llm
LITELLM_IMAGE=ghcr.io/berriai/litellm@sha256:90d8de0ea6fbb3cad145d1019d00a0149ae400b1e18e2011a60f1988f143f672
LITELLM_MASTER_KEY=sk-local-master
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# LiteLLM 日志与成本数据库连接。
LITELLM_DATABASE_URL=postgresql://postgres:changethis@db:5432/litellm

# Optional Doubao (Volcengine Ark, OpenAI-compatible)
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_KEY=

# Application runtime
# 应用环境：local/staging/production。
APP_ENV=local
# 调试开关：生产环境应为 False。
APP_DEBUG=False
# RuntimeClock 默认时区。
APP_TIMEZONE=Asia/Shanghai
# 请求截止时间（秒）；也是 Deep Research fan-out 的总外层截止边界。
REQUEST_DEADLINE_SECONDS=300
# App -> LiteLLM 单次模型 RPC 超时（秒），须小于 REQUEST_DEADLINE_SECONDS。
LITELLM_CLIENT_TIMEOUT_SECONDS=150

# Database contracts
# FastAPI 业务数据库连接。
DATABASE_URL=postgresql+asyncpg://postgres:changethis@localhost:5432/app

# Agent guards
# Main agent model request and tool budgets.
MAIN_MODEL_REQUEST_LIMIT=8
MAIN_TOOL_CALL_LIMIT=6
# The inline Research Agent has an independent model/tool budget.
RESEARCH_AGENT_MODEL_REQUEST_LIMIT=8
RESEARCH_AGENT_TOOL_CALL_LIMIT=18

# Optional OpenTelemetry export
OTEL_SERVICE_NAME=travel-agent-api
OTLP_ENDPOINT=

# Travel tool providers
# Web Search and image discovery are provided by the model's native Web Search
# capability; Maps and weather remain explicit provider-backed tools.
TRAVEL_CORE_ENABLED=True
AMAP_API_KEY=
WEATHER_API_KEY=
# Frankfurter current-reference FX API (no API key required).
FX_BASE_URL=https://api.frankfurter.dev/v2
